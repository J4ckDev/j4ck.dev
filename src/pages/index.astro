---
import { useTranslations } from "@/i18n/utils";
import RootLayout from "@/layouts/RootLayout.astro";

const lang = "en";

const t = useTranslations(lang);
---

<RootLayout lang={lang} title={t("indexpage.title")}>
  <main class="px-5">
    <p class="font-normal">
      I'm an Electronic and Telecommunications Engineer <strong
        >with more than 5 years of experience as a Full Stack Web Developer</strong
      >, working on different projects and continuously expanding my technical
      knowledge while strengthening my programming and communication skills.
      Throughout my career, I've learned to work effectively in dynamic and
      challenging environments, collaborating with teams to make sound technical
      decisions and deliver high-quality, valuable solutions for customers.
    </p>
  </main>
</RootLayout>
